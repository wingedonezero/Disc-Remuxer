/* cuts (src/disc-remuxer/cuts.h): the places a part can start and the rule
 * that turns chapters / times into cuts */
enum DrDiscStart { DR_DISC_START_NONE = 0, DR_DISC_START_CLEAN, DR_DISC_START_BROKEN, DR_DISC_START_OPEN };

typedef struct CutPicture {
    int64_t time;
    int64_t duration;
    uint8_t key;
    uint8_t start;
    uint8_t rasl;
    uint8_t ref;
} CutPicture;

typedef struct CutPoint {
    int64_t zero;
    int64_t key_time;
    int     start;
    int     kept;
    int     undecodable;
    int     left_out;
} CutPoint;

int cut_points(const CutPicture *pics, int nb, int codec, CutPoint **points, int *nb_points);

typedef struct CutRequest {
    int     chapter;
    int64_t time;
    char    text[40];
} CutRequest;

int cut_parse(const char *spec, CutRequest **reqs, int *nb, const char **bad);

enum CutRule { CUT_NEAREST = 0, CUT_NEXT };

typedef struct CutResult {
    int64_t     target;
    int         point;
    int         on_point;
    const char *why;
    int         same_as;
} CutResult;

int cut_resolve(const CutPoint *points, int nb_points, const int64_t *chapters, int nb_chapters, int64_t end,
                const CutRequest *reqs, int nb_reqs, int rule, CutResult *res);

const char *cut_time_text(char *buf, int size, int64_t ticks);

/* the cut stage of the title timeline (src/timeline/disctl_cut.c) */
enum DRCutCodec { DR_CUT_OTHER = 0, DR_CUT_H264, DR_CUT_HEVC };
int ff_disctl_leading_decodes(int start, int codec, int rasl);
int ff_disctl_leading_kept(int start, int codec, int rasl, int ref);
typedef struct DRCutPlace {
    int64_t zero;
    int64_t key_time;
} DRCutPlace;
typedef struct DRCutResult {
    int64_t pictures;
    int64_t left_out;
    int64_t undecodable;
    int64_t first;
    int     start;
} DRCutResult;
typedef struct DRCut DRCut;
int  ff_disctl_cut_open(DRCut **c, void *log, const DRCutPlace *cuts, int nb_cuts, int part, int codec);
int  ff_disctl_cut_frame(DRCut *c, int track, DRFrame *f);
int  ff_disctl_cut_finish(DRCut *c);
void ff_disctl_cut_result(const DRCut *c, DRCutResult *r);
void ff_disctl_cut_close(DRCut **c);
