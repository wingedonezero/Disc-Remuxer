/* libavformat/dvd_internal.h: the DVD-Video disc structure. */

typedef struct DVDIfo {
    int          index;
    int          failed;
    int          bup_only;
    uint8_t     *cache;
    int          cache_size;
    int64_t      ifo_sector;
    int64_t      bup_sector;
    uint32_t     title_vob_blocks;
    uint32_t     title_vob_start;
    int          no_pgcit;
    int          vobu_map_distrusted;
    int         *pgc_same_as;
    int          nb_pgcs;
    int          nb_vobu_map;
    uint32_t     title_vob_base;
    int          css_state;
    uint8_t      css_key[5];
    ...;
} DVDIfo;

typedef struct DVDDisc {
    DVDIfo     **ifos;
    int          nb_ifos;
    int          nr_of_title_sets;
    char        *volume_name;
    char        *text_name;
    ...;
} DVDDisc;

int  ff_dvd_disc_open(void *log, DiscIOFS *fs, const char *dir, int folder, const char *label, DVDDisc *d);
void ff_dvd_disc_free(DVDDisc *d);
/* what libdvdread / libdvdnav reported about the disc (dvd_nav.c) */
void ff_dvd_reports_log(DVDDisc *d);
void ff_dvd_reports_count(const DVDDisc *d, int *harmless, int *breaks);

/* libavformat/dvd_nav.c through the bridge: a navigator on the disc, one
 * title played (dr_nav_play, 36_dvdnav.cdef). */
int tb_dvd_nav_trace(DVDDisc *d, int title, unsigned opts, int max_steps,
                     dr_nav_event *ev, int max_events, dr_nav_result *res);

/* libavformat/dvd_scan.c */
typedef struct DVDScanResult {
    char      name[16];
    uint8_t   title, pgc;
    int       nb_cells;
    uint8_t  *cells;
} DVDScanResult;

typedef struct DVDScan {
    DVDScanResult *results;
    int            nb_results;
} DVDScan;

void ff_dvd_scan_free(DVDScan *s);
extern "Python" void tb_py_scan_line(void *opaque, const char *line);
int tb_dvd_scan(DVDDisc *d, void (*trace)(void *, const char *), DVDScan *out);

/* libavformat/dvd_titles.c through the bridge: scan + title list as text */
int tb_dvd_titles(DVDDisc *d, int cell_mode, int cell_check, int min_length, int *scan_ret, char **dump);
int tb_dvd_titles_from(DVDDisc *d, DVDScanResult *res, int nb, int cell_mode, int cell_check,
                       int min_length, char **dump);
int ff_dvd_cell_check(DVDDisc *d, int vts, int pgcn, int cell, int mode);

/* libavformat/dvd_read.c: a title VOB sector through the checks; through
 * the bridge: a title's segment read through the checks */
int ff_dvd_title_vob_sector(DVDDisc *d, DVDIfo *f, uint32_t sector, uint8_t *buf);
int tb_dvd_segment_dump(DVDDisc *d, int cell_mode, int t, int seg, const char *path, int64_t *nread, int64_t *left);

/* libdvdcss (our addition): one block descrambled with a title key */
void dvdcss_descramble(const unsigned char *p_key, void *p_block);
