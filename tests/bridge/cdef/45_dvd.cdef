/* libavformat/dvd_internal.h: the DVD-Video disc structure. */

typedef struct DVDCell {
    uint32_t     first_sector;
    uint32_t     last_vobu_start_sector;
    uint32_t     last_sector;
    ...;
} DVDCell;

typedef struct DVDPgc {
    uint8_t      nr_of_programs;
    uint8_t      nr_of_cells;
    uint8_t     *program_map;
    DVDCell     *cells;
    ...;
} DVDPgc;

typedef struct DVDIfo {
    int          index;
    int          failed;
    int          bup_only;
    const uint8_t *cache;
    int          cache_size;
    int64_t      ifo_sector;
    int64_t      bup_sector;
    uint32_t     title_vob_blocks;
    uint32_t     title_vob_start;
    int          no_pgcit;
    int          map_untrusted_at_load;
    DVDPgc     **pgcs;
    int         *pgc_same_as;
    int          nb_pgcs;
    int          nb_vobu_map;
    uint32_t     menu_vob_base;
    uint32_t     title_vob_base;
    int          entered_by_navigation;
    ...;
} DVDIfo;

typedef struct DVDDisc {
    DVDIfo     **ifos;
    int          nb_ifos;
    int          nr_of_title_sets;
    char        *volume_name;
    char        *text_name;
    ...;
} DVDDisc;

int  ff_dvd_disc_open(void *log, DiscIOFS *fs, const char *dir, int folder, const char *label, DVDDisc *d);
void ff_dvd_disc_free(DVDDisc *d);
/* what libdvdread / libdvdnav reported about the disc (dvd_nav.c) */
void ff_dvd_reports_log(DVDDisc *d);
void ff_dvd_reports_count(const DVDDisc *d, int *harmless, int *breaks);

/* libavformat/dvd_nav.c through the bridge: a navigator on the disc, one
 * title played (dr_nav_play, 36_dvdnav.cdef). */
int tb_dvd_nav_trace(DVDDisc *d, int title, unsigned opts, int max_steps,
                     dr_nav_event *ev, int max_events, dr_nav_result *res);

/* libavformat/dvd_scan.c */
typedef struct DVDScanResult {
    char      name[16];
    uint8_t   title, pgc;
    int       nb_cells;
    uint8_t  *cells;
} DVDScanResult;

typedef struct DVDScan {
    DVDScanResult *results;
    int            nb_results;
} DVDScan;

void ff_dvd_scan_free(DVDScan *s);
extern "Python" void tb_py_scan_line(void *opaque, const char *line);
int tb_dvd_scan(DVDDisc *d, void (*trace)(void *, const char *), DVDScan *out);

/* libavformat/dvd_titles.c through the bridge: scan + title list as text */
int tb_dvd_titles(DVDDisc *d, int cell_mode, int cell_check, int min_length, int *scan_ret, char **dump);
int tb_dvd_titles_from(DVDDisc *d, DVDScanResult *res, int nb, int cell_mode, int cell_check,
                       int min_length, char **dump);
int ff_dvd_cell_check(DVDDisc *d, int vts, int pgcn, int cell, int mode);

/* libdvdread (dvdread/vob_read.h): a title set's title VOBs read for
 * ripping, each damaged range given back once */
typedef enum { DVD_DAMAGE_NONE, DVD_DAMAGE_ZERO, DVD_DAMAGE_NO_PACK } dvd_damage_t;
typedef struct dvd_vob_reader_s dvd_vob_reader_t;
typedef struct {
    dvd_damage_t kind;
    uint32_t     sector;
    uint32_t     nb_sectors;
    char         file[16];
    int64_t      offset;
    char         last_file[16];
    int64_t      last_offset;
} dvd_vob_damage_t;
uint32_t DVDTitleVOBSectors_rec(const dvd_vob_reader_t *v);
void DVDEndTitleVOBDamage_rec(dvd_vob_reader_t *v, dvd_vob_damage_t *ended);
int DVDUseTitleVOBView_rec(dvd_vob_reader_t *v, const uint32_t *sectors, const uint32_t *counts, int n);
void DVDCloseTitleVOBs_rec(dvd_vob_reader_t *v);

/* libavformat/dvd_read.c: a title VOB sector through the checks (a reading
 * of its own: its damaged ranges given back); through the bridge: a title's
 * segment read through the checks */
dvd_vob_reader_t *ff_dvd_title_vobs_open(DVDDisc *d, DVDIfo *f);
dvd_vob_reader_t *ff_dvd_own_reading(DVDDisc *d, DVDIfo *f);
int ff_dvd_title_vob_read(DVDDisc *d, DVDIfo *f, dvd_vob_reader_t *vr, uint32_t sector, uint8_t *buf,
                          dvd_vob_damage_t *ended);
int ff_dvd_title_vob_sector(DVDDisc *d, DVDIfo *f, uint32_t sector, uint8_t *buf);
int ff_dvd_css_state(DVDDisc *d, const DVDIfo *f, uint8_t *key);
int ff_dvd_map_trusted(const DVDDisc *d, const DVDIfo *f);
/* VOBUs on libdvdread's records (dvd_read.c, vob_read.h) */
typedef struct {
    uint32_t vobu_s_ptm, vobu_e_ptm, vobu_ea, ilvu_ea, next_vobu;
    uint16_t category;
} dvd_vobu_nav_t;
typedef dvd_vobu_nav_t DVDNav;
int ff_dvd_nav_read(DVDDisc *d, DVDIfo *f, uint32_t sector, DVDNav *n);
int ff_dvd_vobu_start_check(DVDDisc *d, DVDIfo *f, uint32_t sector);
int tb_dvd_segment_dump(DVDDisc *d, int cell_mode, int t, int seg, const char *path, int64_t *nread, int64_t *left);

/* libdvdcss (our addition): one block descrambled with a title key */
void dvdcss_descramble(const unsigned char *p_key, void *p_block);

/* the packets of a sector: libdvdread's reader for its stream probe
 * (vob_read.h) and the demuxer's (libavformat/mpeg.h), compared */
typedef struct {
    int         at;
    int         len;
    int         key;
    int         payload;
    int         first_au;
    int         extra;
    const char *why;
} dvd_pack_packet_t;
int DVDPackPacket_rec(const uint8_t *sector, int *off, dvd_pack_packet_t *p);

typedef struct MpegPsDiscPacket {
    int         len;
    int         key;
    int         payload;
    int         first_au;
    int         extra;
    int         at;
    const char *why;
    ...;
} MpegPsDiscPacket;
int ff_mpegps_disc_packet(const uint8_t *s, int *off, MpegPsDiscPacket *p, int lpcm5);
